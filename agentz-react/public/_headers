# Cache policy for Cloudflare Pages / Workers static assets.
# Vercel reads the equivalent rules from vercel.json instead; both are kept in
# sync on purpose so the site caches correctly on either host.
#
# Bundles carry a content hash in the filename, so they can never go stale and
# are safe to freeze for a year. Video and image filenames are stable across
# deploys, so they get a long TTL that self-heals instead of `immutable`. If you
# replace a clip in place and need it live immediately, purge the CDN cache or
# ship it under a new filename.

/assets/index-*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/index-*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/
  Cache-Control: public, max-age=0, must-revalidate
